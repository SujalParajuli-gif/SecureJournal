@page "/analytics"
@inject JournalEntryService Entries

<div class="card p-6">
    <h1 class="text-2xl font-bold">Analytics</h1>
    <p class="muted mt-2">Simple stats based on your saved entries.</p>

    <div class="stats-row mt-5">
        <StatCard Number="@totalEntries" Label="Total entries" />
        <StatCard Number="@totalWords" Label="Total words" />
        <StatCard Number="@topMood" Label="Top mood" />
    </div>

    <div class="grid-2 mt-6">
        <div class="card p-5">
            <div class="font-semibold">Mood counts</div>
            <div class="mt-3 stack">
                @if (moodCounts.Count == 0)
                {
                    <div class="muted">No data.</div>
                }
                else
                {
                    @foreach (var kv in moodCounts)
                    {
                        <div class="flex-between">
                            <div>@kv.Key</div>
                            <div class="muted">@kv.Value</div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card p-5">
            <div class="font-semibold">Top tags</div>
            <div class="mt-3 stack">
                @if (tagCounts.Count == 0)
                {
                    <div class="muted">No data.</div>
                }
                else
                {
                    @foreach (var kv in tagCounts.Take(10))
                    {
                        <div class="flex-between">
                            <div>@kv.Key</div>
                            <div class="muted">@kv.Value</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string totalEntries = "0";
    private string totalWords = "0";
    private string topMood = "-";

    private Dictionary<string, int> moodCounts = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> tagCounts = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Entries.DataChanged += Refresh;
        await LoadAsync();
    }

    private async void Refresh()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        var all = await Entries.GetAllAsync();

        totalEntries = all.Count.ToString();
        totalWords = all.Sum(x => x.WordCount).ToString();

        moodCounts = await Entries.GetMoodCountsAsync();
        tagCounts = await Entries.GetTagCountsAsync();

        topMood = moodCounts.Count == 0 ? "-" : moodCounts.First().Key;
    }

    public void Dispose()
    {
        Entries.DataChanged -= Refresh;
    }
}
