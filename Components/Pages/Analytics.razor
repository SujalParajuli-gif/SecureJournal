@page "/analytics"
@inject JournalEntryService Entries
@inject IJSRuntime JS
@implements IDisposable
@implements IAsyncDisposable

@* Analytics page *@
@* Shows summary stats, mood/tag lists, and Chart.js graphs *@

<div class="card p-6">
    <h1 class="text-2xl font-bold">Analytics</h1>
    <p class="muted mt-2">Simple stats based on your saved entries.</p>

    @* Summary stat cards *@
    <div class="stats-row mt-5">
        <StatCard Number="@totalEntries" Label="Total entries" Icon="library_books" />
        <StatCard Number="@totalWords" Label="Total words" Icon="text_fields" />
        <StatCard Number="@topMood" Label="Top mood" Icon="mood" />
    </div>

    @* Mood counts and tag counts *@
    <div class="grid-2 mt-6">
        <div class="card p-5">
            <div class="font-semibold">Mood counts</div>
            <div class="mt-3 stack">
                @if (moodCounts.Count == 0)
                {
                    @* Empty state *@
                    <div class="muted">No data.</div>
                }
                else
                {
                    @* Mood list *@
                    @foreach (var kv in moodCounts)
                    {
                        <div class="flex-between">
                            <div>@kv.Key</div>
                            <div class="muted">@kv.Value</div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card p-5">
            <div class="font-semibold">Top tags</div>
            <div class="mt-3 stack">
                @if (tagCounts.Count == 0)
                {
                    @* Empty state *@
                    <div class="muted">No data.</div>
                }
                else
                {
                    @* Top 10 tags *@
                    @foreach (var kv in tagCounts.Take(10))
                    {
                        <div class="flex-between">
                            <div>@kv.Key</div>
                            <div class="muted">@kv.Value</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* Chart.js graphs *@
    <div class="grid-2 mt-6">
        <div class="card p-5">
            <div class="font-semibold">Entry frequency (last 30 days)</div>
            <p class="muted text-sm mt-1">Shows how often you wrote entries each day.</p>

            @* Chart canvas: entries per day *@
            <div class="mt-4" style="height: 320px;">
                <canvas id="entriesChart"></canvas>
            </div>
        </div>

        <div class="card p-5">
            <div class="font-semibold">Mood distribution</div>
            <p class="muted text-sm mt-1">Based on your primary mood selections.</p>

            @* Chart canvas: mood distribution *@
            <div class="mt-4" style="height: 320px;">
                <canvas id="moodChart"></canvas>
            </div>
        </div>
    </div>
</div>

@code {
    // Summary values shown on stat cards
    private string totalEntries = "0";
    private string totalWords = "0";
    private string topMood = "-";

    // Mood and tag counts for list display
    private Dictionary<string, int> moodCounts = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, int> tagCounts = new(StringComparer.OrdinalIgnoreCase);

    // Chart.js series data passed through JS interop
    private List<string> _entryLabels = new();
    private List<int> _entryCounts = new();
    private List<string> _moodLabels = new();
    private List<int> _moodValues = new();

    // Flags for rendering charts after DOM is ready
    private bool _hasRendered;
    private bool _renderChartsRequested;

    protected override async Task OnInitializedAsync()
    {
        // Refresh analytics when entries change
        Entries.DataChanged += Refresh;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // DOM ready flag for safe JS calls
        if (firstRender)
            _hasRendered = true;

        // Render charts only after data is loaded and DOM exists
        if (_hasRendered && _renderChartsRequested)
        {
            _renderChartsRequested = false;
            await RenderChartsAsync();
        }
    }

    // Service event handler for refreshing analytics
    private async void Refresh()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Loads analytics values and prepares chart series
    private async Task LoadAsync()
    {
        var all = await Entries.GetAllAsync();

        totalEntries = all.Count.ToString();
        totalWords = all.Sum(x => x.WordCount).ToString();

        moodCounts = await Entries.GetMoodCountsAsync();
        tagCounts = await Entries.GetTagCountsAsync();

        topMood = moodCounts.Count == 0 ? "-" : moodCounts.First().Key;

        await BuildChartSeriesAsync();

        // Chart render request (render happens after UI is ready)
        _renderChartsRequested = true;
    }

    // Builds data arrays for Chart.js
    private async Task BuildChartSeriesAsync()
    {
        var series = await Entries.GetEntryCountSeriesAsync(days: 30);
        _entryLabels = series.Select(x => x.Label).ToList();
        _entryCounts = series.Select(x => x.Count).ToList();

        _moodLabels = moodCounts.Keys.Take(8).ToList();
        _moodValues = _moodLabels.Select(k => moodCounts[k]).ToList();
    }

    // Calls JS interop to render charts
    private async Task RenderChartsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "analyticsCharts.render",
                _entryLabels,
                _entryCounts,
                _moodLabels,
                _moodValues
            );
        }
        catch
        {
            // Ignore chart render errors
        }
    }

    public void Dispose()
    {
        // Event unsubscription to avoid memory leaks
        Entries.DataChanged -= Refresh;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            // Destroy Chart.js instances to prevent leaks
            await JS.InvokeVoidAsync("analyticsCharts.destroy");
        }
        catch
        {
            // Ignore destroy errors
        }
    }
}
