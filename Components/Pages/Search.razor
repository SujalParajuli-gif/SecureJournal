@page "/search"
@inject JournalEntryService Entries
@inject PdfExportService Pdf
@using Microsoft.AspNetCore.Components.Forms

@* Search and filter page *@
@* Supports combined filters and PDF export by date range *@

<div class="card p-6">
    <h1 class="text-2xl font-bold">Search & Filter</h1>
    <p class="muted mt-2">Combine filters and export results by date range.</p>

    @* Filter inputs *@
    <div class="grid-2 mt-6">
        <div>
            @* Text filter (title/content) *@
            <label class="label">Text</label>
            <input class="input" @bind="text" placeholder="Search title or content..." />
        </div>

        <div>
            @* Primary mood filter *@
            <label class="label">Primary Mood</label>
            <select class="input" @bind="mood">
                <option value="">Any mood</option>
                @foreach (var m in allPrimaryMoods)
                {
                    <option value="@m">@m</option>
                }
            </select>
        </div>
    </div>

    @* Date range filters *@
    <div class="grid-2 mt-4">
        <div>
            @* Start date *@
            <label class="label">From</label>
            <InputDate class="input" TValue="DateOnly?" @bind-Value="fromDate" />
        </div>
        <div>
            @* End date *@
            <label class="label">To</label>
            <InputDate class="input" TValue="DateOnly?" @bind-Value="toDate" />
        </div>
    </div>

    @* Tag filter *@
    <div class="mt-4">
        <label class="label">Tag</label>
        <select class="input" @bind="tag">
            <option value="">Any tag</option>
            @foreach (var t in allTags)
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>

    @* Actions *@
    <div class="row mt-5">
        <button class="btn-dark" @onclick="RunSearch">Search</button>
        <button class="btn-light" @onclick="Clear">Clear</button>
    </div>

    @* Results list *@
    <div class="card p-5 mt-6">
        <div class="flex-between">
            <div class="font-semibold">Results (@results.Count)</div>
            @* PDF export uses the selected date range *@
            <button class="btn-light" @onclick="ExportRange">Export PDF (date range)</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            @* Status message (validation/export path) *@
            <div class="muted text-sm mt-3">@message</div>
        }

        <div class="stack mt-4">
            @if (results.Count == 0)
            {
                @* Empty state *@
                <div class="muted">No results.</div>
            }
            else
            {
                @* Result cards *@
                @foreach (var e in results)
                {
                    <div class="card p-4">
                        <div class="flex-between">
                            <div>
                                <div class="font-semibold">@e.Title</div>
                                <div class="muted text-sm">@e.EntryDate.ToString("yyyy-MM-dd") • @e.Category</div>
                            </div>
                            @* Entry link *@
                            <a class="btn-dark" href="@($"/entry/{e.Id}")">Open</a>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(e.PrimaryMood))
                        {
                            <div class="muted text-sm mt-2">Mood: @e.PrimaryMood</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(e.TagsCsv))
                        {
                            <div class="muted text-sm mt-1">Tags: @e.TagsCsv</div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    // Query parameter: /search?q=text
    [SupplyParameterFromQuery(Name = "q")]
    public string? QueryText { get; set; }

    // Filter state
    private string text = "";
    private string mood = "";
    private string tag = "";

    // Date range state
    private DateOnly? fromDate;
    private DateOnly? toDate;

    // UI state
    private string message = "";
    private List<JournalEntry> results = new();

    // Dropdown options
    private List<string> allPrimaryMoods = new();
    private List<string> allTags = new();

    protected override async Task OnInitializedAsync()
    {
        text = QueryText ?? "";

        var moods = await Entries.GetMoodCountsAsync();
        allPrimaryMoods = moods.Keys.ToList();

        var tags = await Entries.GetTagCountsAsync();
        allTags = tags.Keys.ToList();

        await RunSearch();
    }

    // DateOnly start-of-day conversion
    private static DateTime? ToDateTimeStart(DateOnly? d)
        => d.HasValue ? d.Value.ToDateTime(TimeOnly.MinValue) : null;

    // DateOnly end-of-day conversion
    private static DateTime? ToDateTimeEnd(DateOnly? d)
        => d.HasValue ? d.Value.ToDateTime(TimeOnly.MaxValue) : null;

    private async Task RunSearch()
    {
        message = "";

        var from = ToDateTimeStart(fromDate);
        var to = ToDateTimeEnd(toDate);

        results = await Entries.SearchAsync(text, from, to, mood, tag);
    }

    private async Task ExportRange()
    {
        var from = ToDateTimeStart(fromDate);
        var to = ToDateTimeEnd(toDate);

        if (!from.HasValue || !to.HasValue)
        {
            message = "Please set From and To dates first.";
            return;
        }

        var path = await Pdf.ExportRangeAsync(from.Value, to.Value);
        message = $"PDF saved to: {path}";
    }

    private async Task Clear()
    {
        text = "";
        mood = "";
        tag = "";
        fromDate = null;
        toDate = null;

        await RunSearch();
    }
}

