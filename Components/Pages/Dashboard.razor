@page "/"

<div class="grid-dashboard">
    <div class="col-main">
        <GreetingCard Name="User" />

        <div class="stats-row mt-4">
            <StatCard Number="0" Label="Entries this week" />
            <StatCard Number="0" Label="Current streak" />
            <StatCard Number="0" Label="Most common mood" />
        </div>

        <div class="mt-6">
            <TodayEntryCard />
        </div>
    </div>

    <div class="col-right">
        <div class="card p-5">
            <h3 class="font-semibold text-lg">Quick Actions</h3>
            <div class="mt-4 stack">
                <a class="btn-dark w-full" href="/calendar">Open Calendar</a>
                <a class="btn-light w-full" href="/timeline">Timeline View</a>
                <a class="btn-light w-full" href="/analytics">Analytics</a>
            </div>
        </div>

        <div class="card p-5 mt-4">
            <h3 class="font-semibold text-lg">Mini Calendar</h3>
            <p class="muted text-sm mt-1">UI-only calendar widget.</p>
            <div class="mt-3">
                <CalendarMonth Compact="true" />
            </div>
        </div>
    </div>
</div>
