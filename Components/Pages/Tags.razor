@page "/tags"
@inject JournalEntryService Entries

<div class="card p-6">
    <h1 class="text-2xl font-bold">Tags</h1>
    <p class="muted mt-2">Shows tags used in entries.</p>

    <div class="card p-5 mt-6">
        <div class="font-semibold">Tag counts</div>

        <div class="mt-4 stack">
            @if (tagCounts.Count == 0)
            {
                <div class="muted">No tags yet.</div>
            }
            else
            {
                @foreach (var kv in tagCounts)
                {
                    <div class="flex-between">
                        <div>@kv.Key</div>
                        <div class="muted">@kv.Value</div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private Dictionary<string, int> tagCounts = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Entries.DataChanged += Refresh;
        await LoadAsync();
    }

    private async void Refresh()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        tagCounts = await Entries.GetTagCountsAsync();
    }

    public void Dispose()
    {
        Entries.DataChanged -= Refresh;
    }
}
