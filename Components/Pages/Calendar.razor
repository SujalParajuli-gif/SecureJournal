@page "/calendar"

<div class="page-title">
    <h1 class="text-2xl font-bold">Calendar</h1>
    <p class="muted">Jump to any date and view the entry (UI-only).</p>
</div>

<div class="grid-2 mt-4">
    <div>
        <CalendarMonth />
    </div>

    <div class="card p-5">
        <h3 class="font-semibold text-lg">Selected Date</h3>
        <p class="muted text-sm mt-1">In backend phase, this will load the entry for the selected date.</p>

        <div class="mt-4">
            <div class="muted text-xs">Entry</div>
            <div class="empty-box mt-2">
                No entry loaded.
            </div>
        </div>
    </div>
</div>
