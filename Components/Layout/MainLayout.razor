@inherits LayoutComponentBase

<div class="app-shell @(isDark ? "theme-dark" : "")">
    <Sidebar />

    <div class="app-main">
        <TopBar IsDark="@isDark" OnToggleTheme="ToggleTheme" />

        <div class="app-content">
            @Body
        </div>
    </div>
</div>

@code {
    // loading saved theme value from local storage
    private bool isDark;

    protected override void OnInitialized()
    {
        // Using Preferences to persist theme after restart
        isDark = Preferences.Get("theme.dark", false);
    }

    private void ToggleTheme()
    {
        // making a function for switching theme
        isDark = !isDark;

        // saving the theme value so it stays after restart
        Preferences.Set("theme.dark", isDark);
    }
}
