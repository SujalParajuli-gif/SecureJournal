@* creating this component for showing a single stats card on dashboard/streak pages *@

<div class="stat-surface border p-7 rounded-[2.5rem] shadow-sm hover:border-black/20 transition-all flex flex-col justify-between h-40 relative overflow-hidden group">
    <div class="flex items-center justify-between relative z-10">
        @* added this block for icon container styling (primary vs normal) *@
        <div class="p-3 rounded-2xl transition-all @(IsPrimary ? "bg-black text-white shadow-lg shadow-black/10" : "stat-icon")">
            @if (!string.IsNullOrWhiteSpace(Icon))
            {
                @* made the icon smaller for better balance *@
                <span class="material-icons text-xl">@Icon</span>
            }
        </div>

        @if (IsPrimary)
        {
            @* added this label for highlighting the primary stat card *@
            <span class="text-[9px] font-black uppercase tracking-[0.25em] stat-kicker">Activity</span>
        }
    </div>

    <div class="relative z-10">
        @* kept number slightly smaller so the card height stays compact *@
        <h2 class="text-4xl font-bold stat-number tracking-tighter">@Number</h2>
        <p class="stat-label font-bold text-sm mt-1 uppercase tracking-wide">@Label</p>
    </div>
</div>

@code {
    [Parameter] public string Number { get; set; } = "0";
    [Parameter] public string Label { get; set; } = "Label";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool IsPrimary { get; set; } = false;
}
