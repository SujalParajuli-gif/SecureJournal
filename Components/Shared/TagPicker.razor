@using SecureJournal.Data.Helpers
@using SecureJournal.Data.Services
@inject NotificationService Notifier

<div class="card p-4">
    <h3 class="font-semibold text-lg">Tags</h3>
    <p class="muted text-sm mt-1">Choose from prebuilt tags or add custom tags.</p>

    <div class="mt-4">
        <label class="label">Add Custom Tag</label>

        <div class="row">
            @* Student comment: Alphabetic-only validation for custom tags *@
            <input class="input"
                   placeholder="Type tag and press Add"
                   value="@customTag"
                   @oninput="OnCustomTagInput" />
            <button class="btn-dark" @onclick="AddCustomTag">Add</button>
        </div>

        <div class="muted text-xs mt-2">Example: Gym, Exam, Project.</div>
    </div>

    <div class="mt-4">
        <label class="label">Pre-built Tags</label>

        <div class="row">
            <select class="input" @bind="selectedPrebuilt">
                <option value="">Select a tag...</option>
                @foreach (var t in JournalConstants.PrebuiltTags)
                {
                    <option value="@t">@t</option>
                }
            </select>

            <button class="btn-light" @onclick="AddPrebuiltTag">Add</button>
        </div>
    </div>

    <div class="mt-4">
        <label class="label">Selected Tags</label>

        <div class="chips">
            @if (Tags.Count == 0)
            {
                <span class="muted text-sm">No tags selected.</span>
            }
            else
            {
                @foreach (var t in Tags)
                {
                    <button class="chip" @onclick="() => RemoveTag(t)" title="Remove">
                        @t <span class="material-icons">close</span>
                    </button>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public List<string> Tags { get; set; } = new();
    [Parameter] public EventCallback<List<string>> TagsChanged { get; set; }

    private string customTag = "";
    private string selectedPrebuilt = "";

    // Student comment: Avoid showing the same popup for every keypress.
    private bool _tagErrorShown;

    private void OnCustomTagInput(ChangeEventArgs e)
    {
        var raw = (e.Value?.ToString() ?? "");

        if (!InputValidation.IsAlphabeticWithSpaces(raw))
        {
            customTag = InputValidation.KeepOnlyLettersAndSpaces(raw);

            if (!_tagErrorShown)
            {
                _tagErrorShown = true;
                Notifier.ShowError(
                    "Invalid input",
                    "Only alphabetic characters are allowed in Tags (letters and spaces only)."
                );
            }
        }
        else
        {
            customTag = raw;
            _tagErrorShown = false;
        }
    }

    private async Task AddCustomTag()
    {
        var t = (customTag ?? "").Trim();
        if (string.IsNullOrWhiteSpace(t)) return;

        // Student comment: final validation check before adding.
        if (!InputValidation.IsAlphabeticWithSpaces(t))
        {
            Notifier.ShowError(
                "Invalid tag",
                "A tag must contain only alphabetic characters (letters and spaces)."
            );
            return;
        }

        if (!Tags.Any(x => string.Equals(x, t, StringComparison.OrdinalIgnoreCase)))
            Tags.Add(t);

        customTag = "";
        await TagsChanged.InvokeAsync(Tags);
    }

    private async Task AddPrebuiltTag()
    {
        if (string.IsNullOrWhiteSpace(selectedPrebuilt)) return;

        if (!Tags.Any(x => string.Equals(x, selectedPrebuilt, StringComparison.OrdinalIgnoreCase)))
            Tags.Add(selectedPrebuilt);

        selectedPrebuilt = "";
        await TagsChanged.InvokeAsync(Tags);
    }

    private async Task RemoveTag(string t)
    {
        Tags.Remove(t);
        await TagsChanged.InvokeAsync(Tags);
    }
}
