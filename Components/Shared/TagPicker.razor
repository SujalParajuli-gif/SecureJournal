<div class="card p-4">
    <h3 class="font-semibold text-lg">Tags</h3>
    <p class="muted text-sm mt-1">Choose from prebuilt tags or add custom tags (UI-only).</p>

    <div class="mt-4">
        <label class="label">Add Custom Tag</label>

        <div class="row">
            @* We typed custom tag here *@
            <input class="input" placeholder="Type tag and press Add" @bind="customTag" />
            <button class="btn-dark" @onclick="AddCustomTag">Add</button>
        </div>

        <div class="muted text-xs mt-2">Example: “Gym”, “Exam”, “Project”.</div>
    </div>

    <div class="mt-4">
        <label class="label">Pre-built Tags</label>

        <div class="row">
            <select class="input" @bind="selectedPrebuilt">
                <option value="">Select a tag...</option>
                @foreach (var t in JournalConstants.PrebuiltTags)
                {
                    <option value="@t">@t</option>
                }
            </select>

            <button class="btn-light" @onclick="AddPrebuiltTag">Add</button>
        </div>
    </div>

    <div class="mt-4">
        <label class="label">Selected Tags</label>

        <div class="chips">
            @if (Tags.Count == 0)
            {
                <span class="muted text-sm">No tags selected.</span>
            }
            else
            {
                @foreach (var t in Tags)
                {
                    <button class="chip" @onclick="() => RemoveTag(t)" title="Remove">
                        @t <span class="material-icons">close</span>
                    </button>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public List<string> Tags { get; set; } = new(); // We stored selected tags here

    private string customTag = "";        // We kept input text here
    private string selectedPrebuilt = ""; // We kept dropdown value here

    private void AddCustomTag()
    {
        // We cleaned the tag text first
        var t = (customTag ?? "").Trim();
        if (string.IsNullOrWhiteSpace(t)) return;

        // We prevented duplicates (case-insensitive)
        if (!Tags.Any(x => string.Equals(x, t, StringComparison.OrdinalIgnoreCase)))
            Tags.Add(t);

        // We cleared the input after adding
        customTag = "";
    }

    private void AddPrebuiltTag()
    {
        if (string.IsNullOrWhiteSpace(selectedPrebuilt)) return;

        // We prevented duplicates
        if (!Tags.Any(x => string.Equals(x, selectedPrebuilt, StringComparison.OrdinalIgnoreCase)))
            Tags.Add(selectedPrebuilt);

        // We cleared dropdown after adding
        selectedPrebuilt = "";
    }

    private void RemoveTag(string t)
    {
        // We removed the clicked tag
        Tags.Remove(t);
    }
}
