<div class="card p-5">
    <div class="flex-between">
        <div>
            <h2 class="text-xl font-bold">Today’s Entry</h2>
            <p class="muted text-sm">buttons don’t save yet.</p>
        </div>

        <div class="pill">One entry per day</div>
    </div>

    <div class="grid-2 mt-4">
        <div>
            <label class="label">Entry Date</label>

            @* We showed today’s date in the input *@
            <input class="input" type="date" value="@TodayDateValue" />
        </div>

        <div>
            <label class="label">Category</label>

            @* We used a dropdown for category *@
            <select class="input" @bind="Category">
                @foreach (var c in JournalConstants.EntryCategories)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
    </div>

    <div class="mt-4">
        <label class="label">Title</label>

        @* We kept title as a simple input *@
        <input class="input" placeholder="Give your entry a title..." @bind="Title" />
    </div>

    <div class="mt-4">
        <div class="flex-between">
            <label class="label">Content (Markdown)</label>

            @* We toggled preview using this button *@
            <button class="btn-light" @onclick="TogglePreview">
                @(ShowPreview ? "Hide Preview" : "Show Preview")
            </button>
        </div>

        <div class="grid-2 mt-2">
            @* We typed content here *@
            <textarea class="input textarea" placeholder="Write in Markdown..." @bind="Content"></textarea>

            <div class="preview-box">
                @if (!ShowPreview)
                {
                    <div class="muted text-sm">Preview is off. Click “Show Preview”.</div>
                }
                else
                {
                    <div class="preview">
                        @* We displayed basic preview html here *@
                        @((MarkupString)PreviewHtml)
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mt-4">
        @* We reused mood component here *@
        <MoodPicker PrimaryMood="@PrimaryMood" SecondaryMoods="@SecondaryMoods" />
    </div>

    <div class="mt-4">
        @* We reused tag component here *@
        <TagPicker Tags="@Tags" />
    </div>

    <div class="mt-4 timestamps">
        <div>
            <div class="muted text-xs">CreatedAt</div>
            <div class="text-sm">@CreatedAt</div>
        </div>
        <div>
            <div class="muted text-xs">UpdatedAt</div>
            <div class="text-sm">@UpdatedAt</div>
        </div>
    </div>

    <div class="mt-4 row">
        @* We kept buttons for *@
        <button class="btn-dark">Create</button>
        <button class="btn-light">Update</button>
        <button class="btn-danger">Delete</button>
    </div>
</div>

@code {
    // We stored the basic fields here
    private string Title = "";
    private string Content = "";

    // We controlled preview with this boolean
    private bool ShowPreview = true;

    // We kept the first category as default
    private string Category = JournalConstants.EntryCategories[0];

    // We stored mood + tags in simple lists
    private string PrimaryMood = "";
    private List<string> SecondaryMoods = new();
    private List<string> Tags = new();

    // We displayed timestamps as text
    private readonly string CreatedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
    private readonly string UpdatedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm");

    // We formatted date input value like HTML date needs
    private string TodayDateValue => DateTime.Now.ToString("yyyy-MM-dd");

    private void TogglePreview()
    {
        // We flipped preview on/off
        ShowPreview = !ShowPreview;
    }

    private string PreviewHtml
    {
        get
        {
            // We made a simple preview (not full markdown, just basic safe text)
            var text = Content ?? "";

            // We escaped html so user text didn’t break UI
            text = text.Replace("&", "&amp;");
            text = text.Replace("<", "&lt;");
            text = text.Replace(">", "&gt;");

            // We converted new lines to <br/> for preview
            text = text.Replace("\n", "<br/>");

            return text;
        }
    }
}
