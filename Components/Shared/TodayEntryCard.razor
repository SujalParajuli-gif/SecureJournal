@using Markdig
@using SecureJournal.Data.Helpers
@inject JournalEntryService Entries
@inject SecureJournal.Data.Services.NotificationService Notifier
@implements IDisposable

<div class="card p-5">
    <div class="flex-between">
        <div>
            <h2 class="text-xl font-bold">Todays Entry</h2>
            <p class="muted text-sm">@statusText</p>
        </div>

        <div class="pill">One entry per day</div>
    </div>

    <div class="grid-2 mt-4">
        <div>
            <label class="label">Entry Date</label>
            <input class="input" type="date" value="@TodayDateValue" disabled />
        </div>

        <div>
            <label class="label">Category</label>
            <select class="input" @bind="Category">
                @foreach (var c in JournalConstants.EntryCategories)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
    </div>

    <div class="mt-4">
        <label class="label">Title</label>
        @*  Alphabetic-only validation (letters + spaces). *@
        <input class="input"
               placeholder="Give your entry a title..."
               value="@Title"
               @oninput="OnTitleInput" />
    </div>

    <div class="mt-4">
        <div class="flex-between">
            <label class="label">Content (Markdown)</label>
            <button class="btn-light" @onclick="TogglePreview">
                @(ShowPreview ? "Hide Preview" : "Show Preview")
            </button>
        </div>

        <div class="grid-2 mt-2">
            <textarea class="input textarea" placeholder="Write in Markdown..." @bind="Content"></textarea>

            <div class="preview-box">
                @if (!ShowPreview)
                {
                    <div class="muted text-sm">Preview is off. Click Show Preview.</div>
                }
                else
                {
                    <div class="preview">
                        @((MarkupString)PreviewHtml)
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mt-4">
        <MoodPicker @ref="moodPickerRef" @bind-PrimaryMood="PrimaryMood" @bind-SecondaryMoods="SecondaryMoods" />
    </div>

    <div class="mt-4">
        <TagPicker @bind-Tags="Tags" />
    </div>

    <div class="mt-4 timestamps">
        <div>
            <div class="muted text-xs">CreatedAt</div>
            <div class="text-sm">@CreatedAtText</div>
        </div>
        <div>
            <div class="muted text-xs">UpdatedAt</div>
            <div class="text-sm">@UpdatedAtText</div>
        </div>
    </div>

    <div class="mt-4 row">
        <button class="btn-dark" @onclick="SaveToday">@(hasTodayEntry ? "Update" : "Create")</button>
        <button class="btn-danger" @onclick="DeleteToday" disabled="@(!hasTodayEntry)">Delete</button>
    </div>
</div>

@code {
    private MoodPicker? moodPickerRef;

    private string Title = "";
    private string Content = "";
    private bool ShowPreview = true;

    private string Category = JournalConstants.EntryCategories[0];

    private string PrimaryMood = "";
    private List<string> SecondaryMoods = new();
    private List<string> Tags = new();

    private bool hasTodayEntry;
    private int todayId;

    private DateTime createdAt;
    private DateTime updatedAt;

    private string statusText = "Loading...";

    //  Avoid spamming the same popup on every keypress.
    private bool _titleErrorShown;

    private string TodayDateValue => DateTime.Now.ToString("yyyy-MM-dd");
    private string CreatedAtText => createdAt == default ? "-" : createdAt.ToString("yyyy-MM-dd HH:mm");
    private string UpdatedAtText => updatedAt == default ? "-" : updatedAt.ToString("yyyy-MM-dd HH:mm");

    protected override async Task OnInitializedAsync()
    {
        Entries.DataChanged += Refresh;

        await LoadTodayAsync();
    }

    private async void Refresh()
    {
        await LoadTodayAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadTodayAsync()
    {
        statusText = "Loading...";
        var today = DateTime.Now.Date;

        var e = await Entries.GetByDateAsync(today);
        if (e == null)
        {
            hasTodayEntry = false;
            todayId = 0;

            Title = "";
            Content = "";
            PrimaryMood = "";
            SecondaryMoods = new();
            Tags = new();

            createdAt = default;
            updatedAt = default;

            statusText = "No entry for today yet.";
            return;
        }

        hasTodayEntry = true;
        todayId = e.Id;

        Category = e.Category ?? JournalConstants.EntryCategories[0];
        Title = e.Title ?? "";
        Content = e.Markdown ?? "";

        PrimaryMood = e.PrimaryMood ?? "";
        SecondaryMoods = new List<string>();
        if (!string.IsNullOrWhiteSpace(e.SecondaryMood1)) SecondaryMoods.Add(e.SecondaryMood1);
        if (!string.IsNullOrWhiteSpace(e.SecondaryMood2)) SecondaryMoods.Add(e.SecondaryMood2);

        Tags = (e.TagsCsv ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim())
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        createdAt = e.CreatedAt;
        updatedAt = e.UpdatedAt;

        statusText = "Loaded todays entry.";
    }

    private void TogglePreview() => ShowPreview = !ShowPreview;

    private void OnTitleInput(ChangeEventArgs e)
    {
        //  Validate "alphabetic only" (letters + spaces).
        var raw = (e.Value?.ToString() ?? "");

        if (!InputValidation.IsAlphabeticWithSpaces(raw))
        {
            //  Remove invalid chars so the textbox becomes valid again.
            Title = InputValidation.KeepOnlyLettersAndSpaces(raw);

            if (!_titleErrorShown)
            {
                _titleErrorShown = true;
                Notifier.ShowError(
                    "Invalid input",
                    "Only alphabetic characters are allowed in the Title field (letters and spaces only)."
                );
            }
        }
        else
        {
            Title = raw;
            _titleErrorShown = false;
        }
    }

    private string PreviewHtml
    {
        get
        {
            var pipeline = new MarkdownPipelineBuilder()
                .DisableHtml()
                .UseAdvancedExtensions()
                .Build();

            return Markdown.ToHtml(Content ?? "", pipeline);
        }
    }

    private async Task SaveToday()
    {
        //  Required field validation before touching the database.
        if (string.IsNullOrWhiteSpace(PrimaryMood))
        {
            moodPickerRef?.Validate();
            Notifier.ShowError(
                "Primary mood required",
                "Please select one Primary Mood before saving your entry."
            );
            return;
        }

        //  Title already cleaned during typing, but we double-check here too.
        if (!InputValidation.IsAlphabeticWithSpaces(Title))
        {
            Notifier.ShowError(
                "Invalid title",
                "Title can contain only alphabetic characters (letters and spaces)."
            );
            return;
        }

        statusText = "Saving...";

        try
        {
            await Entries.UpsertForDateAsync(
                DateTime.Now.Date,
                Category,
                Title,
                Content,
                PrimaryMood,
                SecondaryMoods,
                Tags
            );

            statusText = "Saved.";
            Notifier.ShowSuccess("Saved", "Your journal entry was saved successfully.");
        }
        catch (Exception ex)
        {
            //  Friendly message for unexpected errors.
            statusText = "Save failed.";
            Notifier.ShowError("Save failed", $"Something went wrong while saving. {ex.Message}");
        }
    }

    private async Task DeleteToday()
    {
        if (!hasTodayEntry || todayId <= 0) return;

        statusText = "Deleting...";

        try
        {
            await Entries.DeleteAsync(todayId);
            statusText = "Deleted.";
            Notifier.ShowSuccess("Deleted", "Today's entry was deleted.");
        }
        catch (Exception ex)
        {
            statusText = "Delete failed.";
            Notifier.ShowError("Delete failed", $"Could not delete the entry. {ex.Message}");
        }
    }

    public void Dispose()
    {
        Entries.DataChanged -= Refresh;
    }
}
